# Genesis/key generator for the ephemeral VPN testnet.
#
# Adapted from blinklabs-io/dingo's internal/test/devnet/Dockerfile.configurator
# (same testnet-generation-tool, same pinned version) - see that repo for the
# original multi-pool version this was trimmed down from.
#
# Pin to the same cardano-node version testnet.sh's own cardano-node
# Deployment manifest uses, so the genesis/config format the tool emits
# matches what the node expects.
FROM ghcr.io/blinklabs-io/cardano-node:11.0.1

USER root

RUN apt update && \
    apt install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        tar \
        python3 \
        python3-pip \
        jq && \
    rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --break-system-packages uv

WORKDIR /usr/local/src
# Pin to v0.1.0 (abab0b3ce616928cae4ea5c36a41654ec068e2e4) - same revision
# blinklabs-io/dingo's DevNet pins.
RUN git clone --branch v0.1.0 --depth 1 https://github.com/cardano-foundation/testnet-generation-tool.git

WORKDIR /usr/local/src/testnet-generation-tool
RUN uv sync && mkdir -p cardano-node && ln -sf /usr/local/bin ./cardano-node/bin

COPY configurator.sh /
RUN chmod 0755 /configurator.sh

ENTRYPOINT ["/configurator.sh"]
